{
  // Loja MONTÊ no Cloudflare Workers.
  // backend/worker.mjs roda o mesmo servidor Express do Render (backend/server.js);
  // os arquivos do site (raiz do repositório) são servidos como assets estáticos.
  // Workers Builds: build "cd backend && npm install", deploy "npx wrangler deploy".
  "name": "monte-site",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Variáveis que não são segredo ficam aqui. As chaves e senhas (Supabase, SuperFrete,
  // admin, Resend...) ficam no painel do Cloudflare como Secret: Settings → Runtime
  // variables and secrets. keep_vars evita que cada deploy apague o que está no painel.
  "keep_vars": true,
  "vars": {
    // Endereço de teste. Na troca do domínio: "https://oficialmontee.com.br".
    "SITE_URL": "https://monte-site.vitorvolpe14.workers.dev",
    // Desligado enquanto o Render ainda envia os pedidos para a Olist.
    // Na troca do domínio: "true" (e suspender o Render).
    "OLIST_SYNC_ENABLED": "false"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Endereços exatamente como no Render: /pagina.html continua /pagina.html (sem redirecionar).
    // As páginas sem ".html" (/, /admin, /pagamento-sucesso) passam pelo servidor.
    "html_handling": "none",
    // Rotas do servidor; o resto (páginas, CSS, JS, fotos) sai direto dos assets.
    "run_worker_first": [
      "/api/*",
      "/webhook-infinitepay",
      "/webhook-pix",
      "/produto/*",
      "/sitemap.xml",
      "/robots.txt",
      "/pagamento-infinitepay",
      "/",
      "/admin",
      "/admin/",
      "/pagamento-sucesso"
    ]
  },
  "triggers": {
    // A cada minuto: pedidos pagos que ainda não chegaram à Olist.
    // A cada 3 horas: renova o acesso à Olist (o refresh token vence sem uso).
    "crons": ["* * * * *", "17 */3 * * *"]
  },
  "observability": { "enabled": true }
}
