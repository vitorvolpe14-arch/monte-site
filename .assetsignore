# Arquivos que não são publicados como assets do Worker (código do servidor e configuração).
.git
.github
.wrangler
.dev.vars*
.gitignore
.assetsignore
node_modules
backend/node_modules
**/node_modules
backend/*.js
backend/*.mjs
backend/package.json
backend/package-lock.json
backend/.env*
wrangler.jsonc
# Variáveis de ambiente, bancos/backup e documentos internos nunca são publicados.
.env*
**/.env*
*.sql
*.md
# Qualquer arquivo do servidor, também em subpastas (só as fotos padrão de backend/assets são públicas).
backend/*
!backend/assets/
